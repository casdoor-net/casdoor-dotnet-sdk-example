@using Casdoor.Client
@using Microsoft.AspNetCore.Mvc.TagHelpers
@inject CasdoorOptions Options

<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <span class="navbar-text text-dark">Hello @User.Identity?.Name!</span>
        <li class="nav-item">
            <a class="nav-link text-dark" href="@(Options.Endpoint.TrimEnd('/'))/account">Profile</a>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="SignOutUser" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Sign out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Sign in</a>
        </li>
    }
</ul>
